# Headers de Cloudflare Pages.
#
# Sin esto, Pages sirve TODO con "Cache-Control: public, max-age=0",
# asi que el navegador revalida los ~165 archivos del juego en cada visita
# y la carga se siente lenta aunque ya este todo descargado.
#
# IMPORTANTE: Pages CONCATENA las reglas que coinciden (no las sobrescribe).
# Si /assets/* y /assets/scripts/* coinciden, el navegador lee el primer
# max-age y termina cacheando el codigo, que es justo lo que no queremos.
# Por eso las carpetas van listadas una por una, sin solaparse.

# Assets pesados: una semana de cache.
/assets/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/game-bg/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/game-ground/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/levels/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/music/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/sheets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/sfx/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/assets/sprites/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/wd_branding/*
  Cache-Control: public, max-age=604800

# Codigo: siempre fresco, para que un deploy nuevo se vea al instante.
# No lleva comodin de assets para no solaparse con las reglas de arriba.
/assets/scripts/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/style.css
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
